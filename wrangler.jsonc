{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webnova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4a872c4f-e186-48d4-8a13-dd26428a06a8","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6df4d667be8d4502aae09ff2c64affe0" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
